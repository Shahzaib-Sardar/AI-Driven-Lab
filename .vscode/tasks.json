{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Backend (Flask)",
			"type": "shell",
			"command": "d:/Copilot/.venv/Scripts/python.exe",
			"args": [
				"backend/run.py"
			],
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Run Frontend Dev Server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev"
			],
			"isBackground": true,
			"group": "build",
			"problemMatcher": []
		}
	]
}